#!/bin/bash

#Submit this script with: sbatch thefilename
#For more details about each parameter, please check SLURM sbatch documentation https://slurm.schedmd.com/sbatch.html

#SBATCH --time=48:00:00   # walltime
#SBATCH --ntasks=1   # number of tasks
#SBATCH --cpus-per-task=1   # number of CPUs Per Task i.e if your code is multi-threaded
#SBATCH --nodes=1   # number of nodes
#SBATCH --mem=10G   # memory per node
#SBATCH -J "gambindex"   # job name
#SBATCH -o "logs/gambindex-%j.out"   # job output file
#SBATCH -e "logs/gambindex-%j.err"   # job error file
#SBATCH --mail-user=rehmann@ebi.ac.uk   # email address
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL

#mkdir -p /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/unindexable

samples=data/vo_agam_release/gambiae_samples.txt

finds=$( awk 'NR > 1 {printf "-o "}; {print "-name", $0".vcf.gz"}' $samples )
finds=$( find /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/ $finds )
for f in $finds; do
    rm $f.tbi
    if pixi exec -c bioconda bcftools index --tbi $f &>/dev/null; then
        echo "$f is indexed at "
        ls $f.tbi
        echo $f >> merge.txt
    fi
done

