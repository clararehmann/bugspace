#!/bin/bash
#SBATCH --time=48:00:00   # walltime
#SBATCH --ntasks=1   # number of tasks
#SBATCH --cpus-per-task=1   # number of CPUs Per Task i.e if your code is multi-threaded
#SBATCH --nodes=1   # number of nodes
#SBATCH --mem=10G   # memory per node
#SBATCH -J "2022hap"   # job name
#SBATCH -o "logs/2022hap-%J.out"   # job output file
#SBATCH -e "logs/2022hap-%J.err"   # job error file
#SBATCH --mail-user=rehmann@ebi.ac.uk   # email address
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL

pixi run python scripts/haplotype_distance.py --years 2022 --out out/2022