#!/bin/bash
#SBATCH --array=0-2
#SBATCH --time=6:00:00   # walltime
#SBATCH --ntasks=1   # number of tasks
#SBATCH --cpus-per-task=1   # number of CPUs Per Task i.e if your code is multi-threaded
#SBATCH --nodes=1   # number of nodes
#SBATCH --mem=30G   # memory per node
#SBATCH -J "drchap"   # job name
#SBATCH -o "logs/drchap-%A-%a.out"   # job output file
#SBATCH -e "logs/drchap-%A-%a.err"   # job error file
#SBATCH --mail-user=rehmann@ebi.ac.uk   # email address
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL

years=( 2016 2017 2018 )
pixi run python scripts/DRC_hapdist.py ${years[$SLURM_ARRAY_TASK_ID]}