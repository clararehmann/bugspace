#!/bin/bash

#Submit this script with: sbatch thefilename
#For more details about each parameter, please check SLURM sbatch documentation https://slurm.schedmd.com/sbatch.html

#SBATCH --time=48:00:00   # walltime
#SBATCH --ntasks=1   # number of tasks
#SBATCH --cpus-per-task=1   # number of CPUs Per Task i.e if your code is multi-threaded
#SBATCH --nodes=1   # number of nodes
#SBATCH --mem=20G   # memory per node
#SBATCH -J "gambmerge"   # job name
#SBATCH -o "logs/gambbigmerge-%j.out"   # job output file
#SBATCH -e "logs/gambbigmerge-%j.err"   # job error file
#SBATCH --mail-user=rehmann@ebi.ac.uk   # email address
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL

#for f in $(find /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/ -name gambiae_merged_*.vcf.gz); do
#        pixi exec -c bioconda bcftools index --tbi $f -f #|| rm $f
#done


# merge VCFs
pixi exec -c bioconda bcftools merge --output-type z --force-samples \
    --output /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/gambiae_merged0.vcf.gz \
    /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/gambiae_merged_*.vcf.gz

pixi exec -c bioconda bcftools index --tbi /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/gambiae_merged0.vcf.gz

