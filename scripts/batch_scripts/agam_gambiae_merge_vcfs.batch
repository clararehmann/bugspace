#!/bin/bash

#Submit this script with: sbatch thefilename
#For more details about each parameter, please check SLURM sbatch documentation https://slurm.schedmd.com/sbatch.html

#SBATCH --time=72:00:00   # walltime
#SBATCH --ntasks=1   # number of tasks
#SBATCH --cpus-per-task=1   # number of CPUs Per Task i.e if your code is multi-threaded
#SBATCH --nodes=1   # number of nodes
#SBATCH --mem=20G   # memory per node
#SBATCH -J "gambmerge"   # job name
#SBATCH -o "logs/allgambmerge-%j.out"   # job output file
#SBATCH -e "logs/allgambmerge-%j.err"   # job error file
#SBATCH --mail-user=rehmann@ebi.ac.uk   # email address
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL

samples=data/vo_agam_release/gambiae_samples.txt

finds=$( awk 'NR > 1 {printf "-o "}; {print "-name", $0".vcf.gz"}' $samples )
merge=$( find /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/ $finds )
merge=$( readarray -t a < merge)
indexes=($( seq 3 1 ${#merge[@]} ))
#merge=$( echo -n $merge )

# merge VCFs
pixi exec -c bioconda bcftools merge --output-type z \
    --output /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/gambiae_merged.vcf.gz \
    $merge

#prev=0
#next=1
for m in "${merge[3:@]}; do
    pixic exec -c bioconda bcftools merge --output-type z
#    vcf=$(find /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/ -name $sample.vcf.gz)
