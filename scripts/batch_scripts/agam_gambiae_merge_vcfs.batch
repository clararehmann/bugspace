    # && prev=$next && next=$(( prev + 1 ))
    
#    echo $line $prev $vcf
#    prev=$next && next=$(( prev + 1 ))
#done

# index the merged VCF
pixi exec -c bioconda bcftools index --tbi /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/gambiae_merged.vcf.gz

