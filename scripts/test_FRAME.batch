#!/bin/bash

#Submit this script with: sbatch thefilename
#For more details about each parameter, please check SLURM sbatch documentation https://slurm.schedmd.com/sbatch.html

#SBATCH --time=15:00:00   # walltime
#SBATCH --ntasks=1   # number of tasks
#SBATCH --cpus-per-task=1   # number of CPUs Per Task i.e if your code is multi-threaded
#SBATCH --nodes=1   # number of nodes
#SBATCH --mem=1G   # memory per node
#SBATCH -J "frametest"   # job name
#SBATCH -o "logs/frametest-%j.out"   # job output file
#SBATCH -e "logs/frametest-%j.err"   # job error file
#SBATCH --mail-user=rehmann@ebi.ac.uk   # email address
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL

pixi run python scripts/agam_gambiae_FRAME.py --vcf /hps/nobackup/jlees/rehmann/vo_agam_release/vcfs/gambiae/gambiae_merged_1551_1600.vcf.gz --chromosome 2L --start 1 --end 10000 --coordinates data/test_latlon.txt --grid data/vo_agam_release/gambiae_grid.shp --edges data/vo_agam_release/gambiae_hull_coords.csv --output test